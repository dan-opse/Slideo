# Optional. The API key enables website ideas and AI writing; manual authoring works without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Maximum AI attempts per UTC day (failed/ambiguous attempts also count).
AI_DAILY_CALL_LIMIT=20
# Local data location; defaults to ./data. Back up this entire directory.
# STUDIO_DATA_DIR=
