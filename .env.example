# Copy to .env.local and restart the studio. Keys stay on the server.

# Enables website ideas, hook generation, and AI drafts. Manual drafts work without it.
OPENAI_API_KEY=

# Optional model override (default: gpt-5.6-luna).
# OPENAI_MODEL=

# Maximum OpenAI calls per account per UTC day, including failed attempts (default: 20).
# AI_DAILY_CALL_LIMIT=20

# Local studio only: where the database, images, and renders are stored (default: ./data).
# STUDIO_DATA_DIR=./data

# --- Hosting (Vercel + Supabase) -------------------------------------------
# Setting the Supabase URL and publishable key turns on accounts and sign-in.
# A hosted studio then also requires DATABASE_URL and SUPABASE_SERVICE_ROLE_KEY.

# Project Settings → API Keys.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The secret key. Server-only: used for file storage, never sent to browsers.
# SUPABASE_SERVICE_ROLE_KEY=

# Connect → Transaction pooler (port 6543).
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Optional: storage bucket name (default: studio) and connections per server (default: 3).
# STORAGE_BUCKET=studio
# DATABASE_POOL_SIZE=3
